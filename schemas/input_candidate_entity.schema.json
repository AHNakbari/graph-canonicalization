{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["candidate_entity_id", "chunk_id", "confidence", "name", "normalized_name", "aliases", "org_id", "source_event_id", "type"],
  "properties": {
    "candidate_entity_id": {"type": "string", "pattern": "^cent_"},
    "chunk_id": {"type": "string", "pattern": "^chunk_"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_text": {"type": "string"},
    "name": {"type": "string"},
    "normalized_name": {"type": "string"},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "org_id": {"type": "string", "pattern": "^org_"},
    "source_event_id": {"type": "string", "pattern": "^event_"},
    "type": {"type": "string"}
  },
  "additionalProperties": false
}
