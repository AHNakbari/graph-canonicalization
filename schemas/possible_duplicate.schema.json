{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Possible duplicate",
  "type": "object",
  "required": ["left_canonical_entity_id", "right_canonical_entity_id", "confidence", "reason_codes", "evidence_candidate_entity_ids"],
  "properties": {
    "left_canonical_entity_id": {"type": "string", "minLength": 1},
    "right_canonical_entity_id": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "evidence_candidate_entity_ids": {"type": "array", "items": {"type": "string", "pattern": "^cent_"}, "minItems": 2, "uniqueItems": true}
  },
  "additionalProperties": true
}
