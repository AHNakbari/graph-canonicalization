{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical edge",
  "type": "object",
  "required": ["canonical_edge_id", "subject_canonical_entity_id", "predicate", "source_candidate_fact_ids", "source_event_ids", "chunk_ids", "confidence"],
  "properties": {
    "canonical_edge_id": {"type": "string", "minLength": 1},
    "subject_canonical_entity_id": {"type": "string", "minLength": 1},
    "predicate": {"type": "string", "minLength": 1},
    "object_canonical_entity_id": {"type": ["string", "null"]},
    "object_value": {},
    "source_candidate_fact_ids": {"type": "array", "items": {"type": "string", "pattern": "^cfact_"}, "minItems": 1, "uniqueItems": true},
    "source_event_ids": {"type": "array", "items": {"type": "string", "pattern": "^event_"}, "minItems": 1, "uniqueItems": true},
    "chunk_ids": {"type": "array", "items": {"type": "string", "pattern": "^chunk_"}, "minItems": 1, "uniqueItems": true},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "anyOf": [
    {"required": ["object_canonical_entity_id"]},
    {"required": ["object_value"]}
  ],
  "additionalProperties": true
}
